<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Планы подписки</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <div class="plan-container">
    <div class="header-row">
      <h1 class="plan-title">Планы подписки</h1>
      <div class="user-info">
        Вы вошли как: <strong><%= user.name %></strong> (<%= user.role %>)
        
        <% if (user.role !== 'guest') { %>
          <% if (user.role === 'admin') { %>
            <a href="/admin/subscriptions" class="btn btn-icon" style="margin-left: 10px; text-decoration: none;">Подписки клиентов</a>
            <a href="/admin/logs" class="btn btn-icon" style="margin-left: 5px; text-decoration: none;">Логи БД</a>
          <% } else if (user.role === 'user') { %>
            <a href="/my-subscriptions" class="btn btn-icon" style="margin-left: 10px; text-decoration: none;">Мои подписки</a>
          <% } %>
          <a href="/logout" class="btn btn-cancel" style="padding: 6px 12px; margin-left: 5px; text-decoration: none;">Выйти</a>
        <% } else { %>
          <a href="/login" class="btn btn-add" style="padding: 6px 12px; margin-left: 10px; text-decoration: none;">Войти</a>
        <% } %>
      </div>
    </div>