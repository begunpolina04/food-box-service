<%- include('partials/header', { user: user }) %>

<% if (user.role === 'admin') { %>
  <button id="openModalBtn" class="btn btn-add" style="width: 100%; margin-bottom: 20px; padding: 15px; font-size: 16px;">
    + Добавить новый план
  </button>
<% } %>

<div class="toolbar">
  <div class="stats-inline">
    Всего планов: <strong><%= plans.length %></strong>
  </div>
</div>

<% if (plans.length === 0) { %>
  <p class="empty-text">Планов не найдено.</p>
<% } else { %>
  <ul class="plans-list">
    <% plans.forEach(plan => { %>
      <% if (user.role === 'admin' || plan.isActive) { %>
        <li class="plan-card <%= !plan.isActive ? 'inactive' : '' %>">
          <div class="plan-info">
            <div style="display: flex; align-items: center; gap: 10px;">
              <a href="/item/<%= plan.id %>" class="plan-name" style="text-decoration: none;"><%= plan.title %></a>
              <span class="status-badge <%= plan.isActive ? 'status-active' : 'status-inactive' %>">
                <%= plan.isActive ? 'Активен' : 'Скрыт' %>
              </span>
            </div>
            <span class="plan-price"><%= Number(plan.price).toFixed(2) %> BYN / нед. • на <%= plan.persons %> чел.</span>
          </div>
          
          <div class="plan-actions">
            <% if (user.role === 'admin') { %>
              <a href="/toggle/<%= plan.id %>" class="btn btn-icon" style="text-decoration: none;"><%= plan.isActive ? 'Скрыть' : 'Включить' %></a>
              <a href="/?edit=<%= plan.id %>" class="btn btn-icon" style="text-decoration: none;">Изменить</a>
              <a href="/delete/<%= plan.id %>" class="btn btn-icon btn-danger" style="text-decoration: none;" onclick="return confirm('Вы уверены, что хотите безвозвратно удалить план «<%= plan.title %>»?')">Удалить</a>
            <% } else if (user.role === 'user') { %>
              
              <% if (userSubscriptions.includes(plan.id)) { %>
                <button type="button" class="btn btn-icon" style="background: #e8f5e9; color: #2e7d32; cursor: not-allowed; padding: 8px 12px;" disabled>Оформлен</button>
              <% } else { %>
                <form action="/subscribe/<%= plan.id %>" method="POST" style="margin: 0;">
                  <button type="submit" class="btn btn-add" style="padding: 8px 12px; font-size: 14px;" onclick="return confirm('Оформить подписку на план «<%= plan.title %>»?')">Оформить</button>
                </form>
              <% } %>
              
            <% } %>
          </div>
        </li>
      <% } %>
    <% }) %>
  </ul>
<% } %>

<!-- Модальное окно (только для админа) -->
<% if (user.role === 'admin') { %>
  <div id="addModal" class="modal-overlay" style="display: none;" data-is-editing="<%= isEditing %>">
    <div class="modal-content">
      <div class="modal-header">
        <h2><%= editingPlan ? 'Редактировать' : 'Новый план' %></h2>
        <button type="button" id="closeModalBtn" class="btn-close" onclick="window.location.href='/'">&times;</button>
      </div>

      <form action="<%= editingPlan ? '/edit/' + editingPlan.id : '/add' %>" method="POST" class="modal-form" id="planForm">
        
        <div class="form-group">
          <label>Название плана</label>
          <input 
            type="text" 
            name="title" 
            id="planTitle"
            value="<%= editingPlan ? editingPlan.title : '' %>" 
            class="plan-input" 
            required 
            minlength="3" 
            maxlength="50"
            placeholder="Например, Витаминный"
          >
        </div>
        
        <div class="form-group">
          <label>Цена (BYN)</label>
          <input 
            type="number" 
            name="price" 
            id="planPrice"
            value="<%= editingPlan ? Number(editingPlan.price).toFixed(2) : '' %>" 
            class="plan-input" 
            required 
            min="0.01" 
            max="1000000" 
            step="0.01"
            placeholder="150.00"
          >
        </div>
        
        <div class="form-group">
          <label>Количество человек</label>
          <select name="persons" id="planPersons" class="plan-input">
            <option value="1" <%= editingPlan && editingPlan.persons === 1 ? 'selected' : '' %>>1 чел.</option>
            <option value="2" <%= editingPlan && editingPlan.persons === 2 ? 'selected' : '' %>>2 чел.</option>
            <option value="4" <%= editingPlan && editingPlan.persons === 4 ? 'selected' : '' %>>4 чел.</option>
          </select>
        </div>

        <div class="form-group">
          <label>Описание плана</label>
          <textarea name="description" id="planDesc" class="plan-input" maxlength="500" rows="3" placeholder="Краткое описание"><%= editingPlan && editingPlan.description ? editingPlan.description : '' %></textarea>
        </div>

        <div class="form-group">
          <label>Состав</label>
          <textarea name="composition" id="planComp" class="plan-input" maxlength="500" rows="3" placeholder="Что входит в бокс"><%= editingPlan && editingPlan.composition ? editingPlan.composition : '' %></textarea>
        </div>
        
        <div class="modal-actions">
          <button type="button" class="btn btn-cancel" onclick="window.location.href='/'">Отмена</button>
          
          <!-- Кнопка Сохранить/Добавить, которая будет блокироваться -->
          <button type="submit" id="planSubmitBtn" class="btn btn-add" style="opacity: 0.5; cursor: not-allowed;" disabled>
            <%= editingPlan ? 'Сохранить' : 'Добавить' %>
          </button>
        </div>
      </form>
    </div>
  </div>

  <script>
    const modal = document.getElementById('addModal');
    const openBtn = document.getElementById('openModalBtn');
    const isEditing = modal.getAttribute('data-is-editing') === 'true';

    // Элементы формы
    const planTitle = document.getElementById('planTitle');
    const planPrice = document.getElementById('planPrice');
    const planSubmitBtn = document.getElementById('planSubmitBtn');

    if (openBtn) {
      openBtn.onclick = () => modal.style.display = 'flex';
    }
    
    if (isEditing) {
      modal.style.display = 'flex';
    }

    // --- ЛОГИКА ЖИВОЙ ВАЛИДАЦИИ ---
    
    function validatePlanField(input, condition) {
      if (input.value.length === 0) {
        input.style.borderColor = '#FFE4D6';
        input.style.boxShadow = 'none';
        return false;
      } else if (condition) {
        input.style.borderColor = '#4CAF50'; // Зеленый
        input.style.boxShadow = '0 0 0 3px rgba(76, 175, 80, 0.2)';
        return true;
      } else {
        input.style.borderColor = '#CD5C5C'; // Красный
        input.style.boxShadow = '0 0 0 3px rgba(205, 92, 92, 0.2)';
        return false;
      }
    }

    function checkPlanForm() {
      // Проверка названия (от 3 до 50 символов)
      const isTitleValid = planTitle.value.trim().length >= 3 && planTitle.value.length <= 50;
      
      // Проверка цены (больше 0, не больше 1000000, и не более 2 знаков после запятой)
      const priceVal = Number(planPrice.value);
      const priceRegex = /^\d+([.,]\d{1,2})?$/;
      const isPriceValid = planPrice.value !== '' && priceVal > 0 && priceVal <= 1000000 && priceRegex.test(planPrice.value);

      validatePlanField(planTitle, isTitleValid);
      validatePlanField(planPrice, isPriceValid);

      // Если всё введено верно — включаем кнопку
      if (isTitleValid && isPriceValid) {
        planSubmitBtn.disabled = false;
        planSubmitBtn.style.opacity = '1';
        planSubmitBtn.style.cursor = 'pointer';
      } else {
        planSubmitBtn.disabled = true;
        planSubmitBtn.style.opacity = '0.5';
        planSubmitBtn.style.cursor = 'not-allowed';
      }
    }

    // Добавляем слушатели событий на ввод
    planTitle.addEventListener('input', checkPlanForm);
    planPrice.addEventListener('input', checkPlanForm);

    // Проверяем форму при открытии (если это редактирование)
    checkPlanForm();
  </script>
<% } %>

<%- include('partials/footer') %>