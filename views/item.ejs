<%- include('partials/header', { user: user }) %>

<div class="plan-card" style="flex-direction: column; align-items: flex-start;">
  <h2 style="margin-top: 0; color: #D2691E; font-size: 28px;"><%= plan.title %></h2>
  
  <div style="font-size: 18px; margin: 15px 0; display: flex; gap: 30px; flex-wrap: wrap;">
    <p style="margin: 0;">Стоимость: <strong><%= Number(plan.price).toFixed(2) %> BYN / нед.</strong></p>
    <p style="margin: 0;">Количество человек: <strong><%= plan.persons %></strong></p>
    <p style="margin: 0;">Статус: <span class="status-badge <%= plan.isActive ? 'status-active' : 'status-inactive' %>"><%= plan.isActive ? 'Активен' : 'Скрыт' %></span></p>
  </div>

  <hr style="width: 100%; border: 0; border-top: 1px solid #f0f0f0; margin: 20px 0;">

  <% if (plan.description) { %>
    <div style="margin-bottom: 20px; width: 100%;">
      <h3 style="color: #8B4513; margin-bottom: 10px; font-size: 20px;">Описание</h3>
      <p style="margin: 0; font-size: 16px; line-height: 1.6; color: #4A3B32;"><%= plan.description %></p>
    </div>
  <% } %>

  <% if (plan.composition) { %>
    <div style="margin-bottom: 30px; width: 100%;">
      <h3 style="color: #8B4513; margin-bottom: 10px; font-size: 20px;">Состав</h3>
      <p style="margin: 0; font-size: 16px; line-height: 1.6; color: #4A3B32;"><%= plan.composition %></p>
    </div>
  <% } %>
  
  <a href="/" class="btn btn-cancel" style="margin-top: 10px; text-decoration: none; padding: 12px 20px; font-size: 16px;">← Назад к списку</a>
</div>

<%- include('partials/footer') %>