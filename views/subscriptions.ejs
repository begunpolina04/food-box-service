<%- include('partials/header', { user: user }) %>

<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; margin-top: 20px; flex-wrap: wrap; gap: 10px;">
  <h1 class="plan-title" style="margin: 0; font-size: 28px;">Мои подписки</h1>
  
  <div style="display: flex; gap: 10px;">
    <a href="/" class="btn btn-add" style="text-decoration: none; padding: 10px 15px;">← Вернуться к планам</a>
    <a href="/logout" class="btn btn-cancel" style="text-decoration: none; padding: 10px 15px;">Выйти</a>
  </div>
</div>

<% if (subscriptions.length === 0) { %>
  <div class="empty-text">
    <p>У вас пока нет активных подписок.</p>
    <a href="/" class="btn btn-add" style="text-decoration: none; margin-top: 10px;">Выбрать план</a>
  </div>
<% } else { %>
  <ul class="plans-list">
    <% subscriptions.forEach(sub => { %>
      <li class="plan-card" style="border-left-color: #4CAF50;">
        <div class="plan-info">
          <div style="display: flex; align-items: center; gap: 10px;">
            <span class="plan-name"><%= sub.Plan.title %></span>
            <span class="status-badge" style="background: #e8f5e9; color: #2e7d32;">Оплачено</span>
          </div>
          <span class="plan-price"><%= sub.Plan.price %> BYN / нед. • на <%= sub.Plan.persons %> чел.</span>
          <span style="font-size: 12px; color: #999; margin-top: 5px;">Оформлено: <%= sub.createdAt.toLocaleDateString() %></span>
        </div>
      </li>
    <% }) %>
  </ul>
<% } %>

<%- include('partials/footer') %>